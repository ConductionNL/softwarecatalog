{
  "name": "stackiq",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "sideEffects": true,
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:parity": "node tests/l10n/check-l10n.js --parity",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:vue-demi": "node scripts/check-vue-demi.js",
    "prebuild": "npm run check:vue-demi",
    "predev": "npm run check:vue-demi",
    "prewatch": "npm run check:vue-demi",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src tests scripts",
    "lint-fix": "npm run lint -- --fix && npm run format:fix",
    "test": "jest --silent",
    "test-coverage": "jest --silent --coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project smoke",
    "stylelint": "stylelint \"{src,css}/**/*.{vue,scss,css}\"",
    "check:manifest": "node tests/validate-manifest.js",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "l10n:build": "node scripts/build-l10n-js.js",
    "check:l10n-js": "node scripts/build-l10n-js.js --check"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.22.9",
    "@codemirror/lang-json": "^6.0.0",
    "@conduction/nextcloud-vue": "^2.37.0",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@toast-ui/editor": "^3.2.0",
    "@vueuse/core": "^14.4.0",
    "axe-core": "^4.12.1",
    "babel-loader": "^10.1.1",
    "css-loader": "~7.1.1",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "lodash": "^4.17.21",
    "marked": "^18.0.11",
    "node-polyfill-webpack-plugin": "4.1.0",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.3",
    "sass": "^1.99.0",
    "sass-loader": "^17.0.0",
    "style-loader": "~4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.40",
    "vue-codemirror6": "^1.0.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-loader": "^17.4.2",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4",
    "webpack": "^5.110.1",
    "webpack-cli": "^6.0.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@babel/traverse": "^7.23.2",
    "babel-traverse": "npm:@babel/traverse@^7.23.2",
    "fast-xml-parser": ">=4.5.4",
    "immutable": ">=5.1.5",
    "json5": ">=1.0.2",
    "serialize-javascript": ">=7.0.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.9",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "browserslist": "^4.25.2",
    "caniuse-lite": "^1.0.30001810",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^6.0.0",
    "espree": "^11.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.5.0",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^30.0.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.3.0"
  },
  "prettier": "@nextcloud/prettier-config"
}
